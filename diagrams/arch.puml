@startuml
left to right direction
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam roundCorner 5
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13

' --- Define thick borders for main nodes ---
skinparam component {
  BorderThickness 2
  BackgroundColor white
}

skinparam database {
  BorderThickness 2
  BackgroundColor white
}

' --- Actor ---
actor "Utilisateur" as User

' --- Frontend ---
component "Front-End (React + Vite)" as FE {
  component "Tailwind CSS" as TW
  component "Axios" as Axios
}

' --- Backend ---
component "Back-End (Spring Boot)" as BE {
  component "API RESTful" as REST
  component "Spring Data JPA" as JPA
}

' --- Database ---
database "MySQL" as DB {
  folder "Tables" {
    [employe]
    [presence]
    [utilisateurs]
  }
}

' --- Connections ---
User -right-> FE : 1. HTTP (Navigateur)
FE -right-> BE : 2. Axios / API REST
BE -right-> DB : 3. JPA / Hibernate

@enduml